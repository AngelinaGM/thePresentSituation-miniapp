DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/party_wishlist
# Token from @BotFather
BOT_TOKEN=
# Username of the bot without @ (needed to make invite deep links)
BOT_USERNAME=
# Public HTTPS address where this app is deployed, no trailing slash
APP_URL=https://example.com
# A long random value used to sign browser sessions
SESSION_SECRET=change-this-to-a-long-random-string
# Port for local development
PORT=3000
